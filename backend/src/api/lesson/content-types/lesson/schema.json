{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "videoUrl": {
      "type": "string"
    },
    "content": {
      "type": "text"
    },
    "order": {
      "type": "integer",
      "required": true
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "required": true,
      "inversedBy": "lessons"
    },
    "lessonProgresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::lesson-progress.lesson-progress",
      "mappedBy": "lesson"
    }
  }
}
